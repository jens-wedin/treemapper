{
  "name": "treemapper",
  "private": true,
  "version": "1.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch api/server.ts\" \"vite\"",
    "dev:e2e": "TREEMAPPER_E2E=1 TREEMAPPER_DB=.e2e/trees/wedin.db TREEMAPPER_TREES_DIR=.e2e/trees TREEMAPPER_MEDIA_DIR=.e2e/media API_PORT=3199 concurrently -k \"tsx api/server.ts\" \"vite --port 5199\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "import": "tsx scripts/import.ts",
    "media": "tsx scripts/download-media.ts",
    "refresh-media": "tsx scripts/refresh-media-urls.ts",
    "export": "tsx scripts/export.ts",
    "repair-conc": "tsx scripts/repair-conc.ts",
    "merge-duplicates": "tsx scripts/merge-duplicates.ts",
    "dev:first-run": "TREEMAPPER_E2E=1 TREEMAPPER_DB=.first-run/family.db TREEMAPPER_TREES_DIR=.first-run/trees TREEMAPPER_MEDIA_DIR=.first-run/media API_PORT=3198 concurrently -k \"tsx api/server.ts\" \"vite --port 5198\""
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@hono/node-server": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.0",
    "lucide-react": "^1.29.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
