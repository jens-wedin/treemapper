# `*.db` alone does not match `wedin.db.before-merge` — a glob needs the name to
# end in .db — so four backup copies of the family database were tracked for
# months. These databases hold living people; nothing shaped like one goes in.
*.db.*
backups/
*.db-journal
*.db-wal
*.db-shm
*.tsbuildinfo
.DS_Store
